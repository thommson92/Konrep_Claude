# =============================================================================
# Konrep – Apache-Konfiguration für STRATO
# Erzwingt HTTPS und eine einheitliche Domain (ohne www).
# Hinweis: SSL-Zertifikat (Let's Encrypt) muss im STRATO-Kundenbereich
# aktiviert sein, damit die HTTPS-Weiterleitung greift.
# =============================================================================

RewriteEngine On

# 1) Auf HTTPS umleiten
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) www -> ohne www (konrep.com)
RewriteCond %{HTTP_HOST} ^www\.konrep\.com [NC]
RewriteRule ^(.*)$ https://konrep.com/$1 [L,R=301]

# Standard-Startseite
DirectoryIndex index.html

# -----------------------------------------------------------------------------
# Sicherheits-Header
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS erst aktivieren, wenn HTTPS zuverlässig läuft:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -----------------------------------------------------------------------------
# Caching statischer Dateien
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 1 day"
</IfModule>

# -----------------------------------------------------------------------------
# Komprimierung
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
